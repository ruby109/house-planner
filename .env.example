# house-planner —— M3「AI 识别間取り图」的服务端配置
# 复制本文件为 .env（.env 已加入 .gitignore，不会被提交）。
# 只有 `npm run dev:api`（server/dev.mjs）与 `server/test-recognize.mjs` 会读它，
# 前端永远不接触 key。

# ---------------------------------------------------------------------------
# provider（二选一，或都填由 RECOGNIZE_PROVIDER 决定）
# ---------------------------------------------------------------------------

# OpenRouter：一个 key 打通多家模型，方便横向对比。
# 到 https://openrouter.ai/keys 创建，形如 sk-or-v1-...
OPENROUTER_APIKEY=

# Anthropic 原生 SDK 路径。到 https://console.anthropic.com/settings/keys 创建，形如 sk-ant-...
ANTHROPIC_API_KEY=

# 可选：显式选 provider —— openrouter | anthropic
# 不填时的默认规则：有 OPENROUTER_APIKEY 且没有 ANTHROPIC_API_KEY → openrouter，否则 anthropic。
RECOGNIZE_PROVIDER=

# ---------------------------------------------------------------------------
# 模型
# ---------------------------------------------------------------------------

# 可选：覆盖识别用的模型。
# 不填时：openrouter → openai/gpt-5.6-luna-pro；anthropic → claude-opus-5。
RECOGNIZE_MODEL=

# 可选：请求体 `model` 字段（以及对话框下拉、test-recognize.mjs）的 allowlist，逗号分隔。
# 不填时就是下面这三个——这次要横向对比的模型。
RECOGNIZE_MODELS=openai/gpt-5.6-luna-pro

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------

# 可选：设为 1 时不调用真实 API，直接返回 server/fixtures/mock-2ldk.json（示例 2LDK）。
# 也可以不改这里，直接跑 `npm run dev:api:mock`。
MOCK_RECOGNIZE=

# 可选：API 服务端口（默认 8787，需与 vite.config.ts 的 proxy 目标一致）
API_PORT=8787
